@startuml 02_Diagrama_Clases_Por_Capas
' Actividad 3 - Modelo por capas: Controller -> Service -> Repository
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle

package "controller" {
  class PrestamoController <<RestController>> {
    - prestamoService : PrestamoService
    + PrestamoController(prestamoService : PrestamoService)
    + registrar(request : PrestamoRequest) : ResponseEntity<PrestamoResponse>
    + listar() : ResponseEntity<List<PrestamoResponse>>
  }
  class ManejadorExcepciones <<RestControllerAdvice>> {
    + manejarNoEncontrado(ex : RecursoNoEncontradoException) : ResponseEntity<String>
    + manejarNoDisponible(ex : LibroNoDisponibleException) : ResponseEntity<String>
  }
}

package "dto" {
  class PrestamoRequest <<record>> {
    + estudianteId : String {NotBlank}
    + libroId : String {NotBlank}
  }
  class PrestamoResponse <<record>> {
    + id : String
    + estudianteNombre : String
    + libroTitulo : String
    + fechaPrestamo : LocalDate
    + {static} desde(p : Prestamo) : PrestamoResponse
  }
}

package "service" {
  class PrestamoService <<Service>> {
    - estudianteRepository : EstudianteRepository
    - libroRepository : LibroRepository
    - prestamoRepository : PrestamoRepository
    + registrarPrestamo(request : PrestamoRequest) : Prestamo
    + listarPrestamos() : List<Prestamo>
  }
  class RecursoNoEncontradoException <<exception>>
  class LibroNoDisponibleException <<exception>>
}

package "repository" {
  interface "MongoRepository<T, ID>" as MongoRepository <<Spring Data>> {
    + findById(id : ID) : Optional<T>
    + findAll() : List<T>
    + save(entidad : T) : T
  }
  interface EstudianteRepository
  interface LibroRepository
  interface PrestamoRepository {
    + existsByLibroIdAndFechaDevolucionIsNull(libroId : String) : boolean
  }
}

package "model" {
  class Estudiante <<Document>> {
    - id : String
    - nombre : String
    - correo : String
    + getId() : String
    + getNombre() : String
  }
  class Libro <<Document>> {
    - id : String
    - titulo : String
    - disponible : boolean
    + getId() : String
    + getTitulo() : String
    + isDisponible() : boolean
    + marcarPrestado() : void
  }
  class Prestamo <<Document>> {
    - id : String
    - fechaPrestamo : LocalDate
    - fechaDevolucion : LocalDate [0..1]
    - estudiante : Estudiante
    - libro : Libro
    + Prestamo(estudiante : Estudiante, libro : Libro, fecha : LocalDate)
    + getId() : String
    + estaActivo() : boolean
  }
}

' Relaciones estructurales entre capas (atributo inyectado por constructor)
PrestamoController "1" --> "1" PrestamoService
PrestamoService "1" --> "1" EstudianteRepository
PrestamoService "1" --> "1" LibroRepository
PrestamoService "1" --> "1" PrestamoRepository

' Generalizacion entre interfaces (Spring Data genera la implementacion en tiempo de ejecucion)
MongoRepository <|-- EstudianteRepository : T=Estudiante
MongoRepository <|-- LibroRepository : T=Libro
MongoRepository <|-- PrestamoRepository : T=Prestamo

' Asociaciones del dominio (navegables desde Prestamo, @DocumentReference: se guardan los ids)
Prestamo "0..*" --> "1" Estudiante : estudiante
Prestamo "0..*" --> "1" Libro : libro

' Dependencias (uso puntual: parametro, retorno, creacion, excepcion)
PrestamoController ..> PrestamoRequest : <<use>>
PrestamoController ..> PrestamoResponse : <<create>>
PrestamoService ..> PrestamoRequest : <<use>>
PrestamoService ..> Prestamo : <<create>>
PrestamoService ..> RecursoNoEncontradoException : <<throw>>
PrestamoService ..> LibroNoDisponibleException : <<throw>>
PrestamoResponse ..> Prestamo : <<use>>
ManejadorExcepciones ..> RecursoNoEncontradoException : <<use>>
ManejadorExcepciones ..> LibroNoDisponibleException : <<use>>
Libro ..> LibroNoDisponibleException : <<throw>>

note right of PrestamoService
  Controlador GRASP del caso de uso
  "Registrar prestamo". Valida todo antes
  de escribir (R1, R4, R5). MongoDB es atomico
  por documento: guarda primero el prestamo.
end note

note bottom of Libro
  Experto en informacion: marcarPrestado()
  lanza LibroNoDisponibleException si
  disponible == false (protege R1 y R3).
end note
@enduml
